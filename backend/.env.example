# App Configuration
ENVIRONMENT=development
JWT_SECRET_KEY=your-secret-key-change-in-production-use-32-chars-minimum

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arattai_db

# Redis
REDIS_URL=redis://localhost:6379

# AI Services
GOOGLE_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# Storage (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key

# Storage (AWS - Alternative)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=arattai-user-data
AWS_REGION=ap-south-1

# Email
RESEND_API_KEY=your-resend-api-key

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
